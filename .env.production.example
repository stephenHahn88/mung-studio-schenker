# Dotenv production config file
# =============================
#
# This .env.production file is used when you build MuNG Studio with
#   npm run build
#
# SAME_ORIGIN expects the built frontend to be served by the backend itself:
#   python3 simple-php-backend/server.py --frontend dist
SIMPLE_PHP_BACKEND_URL=SAME_ORIGIN

# Model action flags (see .env.example).
#MUNG_ENABLE_SYMBOL_INFERENCE=true
#MUNG_ENABLE_RELATION_INFERENCE=true
#MUNG_ENABLE_INFERENCE=true
