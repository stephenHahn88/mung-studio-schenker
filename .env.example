# Dotenv configuration file
# =========================
#
# This .env file is used when you develop MuNG Studio with
#   npm start
#
# This file defines the configuration for the MuNG Studio. It is loaded by
# Parcel during the build process. Copy this file and rename it to ".env"
# and then modify the contents to fit your needs. More about Parcel dotenv
# files can be read here: https://parceljs.org/features/node-emulation/

# Backend
# -------
#
# URL of the Python backend (simple-php-backend/server.py). The query
# parameters "?action=..." are appended directly to this URL. The backend
# serves the documents and the model actions.
#
# Example values:
# http://localhost:8080
# SAME_ORIGIN   (the backend also serves the built frontend; see --frontend)
# AUTO          (development behind a port proxy: port 1234 is replaced by 8080)
SIMPLE_PHP_BACKEND_URL=http://localhost:8080

# Model actions
# -------------
#
# Symbol detection and the relation models (syntax links, time groups,
# precedence links) can be hidden independently. A scoped flag overrides
# MUNG_ENABLE_INFERENCE. If no flag is set, the model actions are shown.
# Which models are actually available is configured on the backend.
#MUNG_ENABLE_SYMBOL_INFERENCE=true
#MUNG_ENABLE_RELATION_INFERENCE=true
#MUNG_ENABLE_INFERENCE=true

# Dataset Errata
# --------------
#
# Link to an external ticketing system that lets annotators report issues
# of specific documents in the annotated dataset.

#DATASET_ERRATA_URL=https://github.com/OmniOMR/dataset-errata
